{
	"name": "newblogwebsite",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "node scripts/run-with-translations.mjs node_modules/vite/bin/vite.js --host 127.0.0.1",
		"build": "node scripts/generate-dutch-translations.mjs && vite build",
		"translate:nl": "node scripts/generate-dutch-translations.mjs",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"validate:seo": "tsx scripts/validate-seo.ts",
		"validate:rendered": "tsx scripts/validate-rendered-seo.ts",
		"verify:cdn": "tsx scripts/verify-cdn-media.ts",
		"snapshot:immich": "node scripts/snapshot-immich-album.mjs",
		"lighthouse": "lhci autorun",
		"quality": "npm run check && npm run validate:seo && npm run build && npm run validate:rendered"
	},
	"devDependencies": {
		"@lhci/cli": "^0.15.1",
		"@sveltejs/adapter-node": "^5.2.13",
		"@sveltejs/kit": "^2.25.1",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@tailwindcss/typography": "^0.5.12",
		"@types/eslint": "8.56.0",
		"@types/node": "^24.0.15",
		"@types/nodemailer": "^7.0.3",
		"@types/svelte-leafletjs": "^0.8.7",
		"autoprefixer": "^10.4.19",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.39.0",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.2.3",
		"prettier-plugin-tailwindcss": "^0.5.14",
		"svelte": "^4.2.20",
		"svelte-check": "^3.7.1",
		"tailwindcss": "^3.4.3",
		"tslib": "^2.6.2",
		"tsx": "^4.23.1",
		"typescript": "^5.4.5",
		"vite": "^5.2.8"
	},
	"type": "module",
	"dependencies": {
		"gray-matter": "^4.0.3",
		"leaflet": "^1.9.4",
		"lucide-svelte": "^0.533.0",
		"marked": "^16.1.1",
		"mdsvex": "^0.11.0",
		"nodemailer": "^7.0.5",
		"svelte-email": "^0.0.4",
		"svelte-leafletjs": "^1.0.1"
	},
	"overrides": {
		"rollup": "^4.46.3"
	}
}
